# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
# Database Connection URL (Targets Docker DB container hostname in compose)
DATABASE_URL=postgresql://postgres:password123@db:5432/sparechange

# Local AI Connection URL (Targets Docker Ollama container hostname in compose)
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=llama3

# Authentication Security keys
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_value

# Execution Environment config
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Point to your production domain proxy URL (Caddy proxy)
EXPO_PUBLIC_API_URL=https://yourapp.duckdns.org/api
